---
import { products } from '../../data/products';
import ProductDetail from '../../components/pages/ProductDetail.astro';
import ProductSupport from '../../components/pages/ProductSupport.astro';
import ProductPrivacy from '../../components/pages/ProductPrivacy.astro';
import Home from '../../components/pages/Home.astro';
import About from '../../components/pages/About.astro';
import Contact from '../../components/pages/Contact.astro';
import Products from '../../components/pages/Products.astro';
import SameJob from '../../components/pages/SameJob.astro';
import Privacy from '../../components/pages/Privacy.astro';
import Support from '../../components/pages/Support.astro';

export function getStaticPaths() {
  const pages = {
    '/': Home,
    '/about': About,
    '/products': Products,
    '/products/samejob': SameJob,
    '/products/samejob/privacy': Privacy,
    '/products/samejob/support': Support,
    '/contact': Contact,
  };
  return [
    ...Object.entries(pages).map(([route, Page]) => ({
      params: { path: route === '/' ? undefined : route.slice(1) },
      props: { Page, product: undefined },
    })),
    ...products
      .filter((p) => p.slug !== 'samejob')
      .flatMap((product) => [
        {
          params: { path: `products/${product.slug}` },
          props: { product, Page: ProductDetail },
        },
        {
          params: { path: `products/${product.slug}/support` },
          props: { product, Page: ProductSupport },
        },
        {
          params: { path: `products/${product.slug}/privacy` },
          props: { product, Page: ProductPrivacy },
        },
      ]),
  ];
}
const { Page, product } = Astro.props;
---

<Page locale="zh-CN" product={product!} />
