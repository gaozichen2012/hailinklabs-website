---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Hailink Labs"
  description="This page could not be found. Explore products from Hailink Labs or return to the home page."
  noindex
>
  <section class="page-intro not-found">
    <p class="eyebrow">404 / Page not found</p>
    <h1>
      Let’s get you
      <br />
      <span class="muted-heading">back on track.</span>
    </h1>
    <p class="intro-copy">
      This page may have moved, or the address may be incorrect.
    </p>
    <a class="button" href="/">
      Back to Hailink Labs <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>
