---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Hailink Labs"
  description="This page could not be found. Browse Hailink Labs apps or return to the English or Chinese homepage."
  noindex
>
  <section class="page-intro not-found">
    <h1>Page not found</h1>
    <p class="intro-copy">
      This page may have moved, or the address may be incorrect.
    </p>
    <a class="button" href="/">
      Back to Hailink Labs <span aria-hidden="true">↗</span>
    </a>
    <a class="text-link" href="/products">
      Browse apps
    </a>
    <a class="text-link" href="/zh" lang="zh-CN">
      返回中文首页
    </a>
  </section>
</Layout>
