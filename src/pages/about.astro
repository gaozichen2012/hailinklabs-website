---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="About — Hailink Labs"
  description="Hailink Labs is the software brand of 深圳市海狸智联科技有限公司, based in Shenzhen, China."
>
  <section class="page-intro">
    <p class="eyebrow">About Hailink Labs</p>
    <h1>
      Small details.
      <br />
      <span class="muted-heading">Everyday value.</span>
    </h1>
    <p class="intro-copy">We build focused software around practical needs.</p>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>Who we are</h2>
    </div>
    <div class="section-body prose">
      <p>
        Hailink Labs is a software company based in Shenzhen, China. Hailink
        Labs is the brand of <span lang="zh-Hans">{site.legalName}</span>.
      </p>
      <p>
        Our work centers on useful apps with clear workflows and a considered
        user experience. We value simplicity and reliability in both the
        software we build and the way we maintain it.
      </p>
      <dl class="company-details">
        <div>
          <dt>Brand</dt>
          <dd>{site.name}</dd>
        </div>
        <div>
          <dt>Legal entity</dt>
          <dd lang="zh-Hans">{site.legalName}</dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>Shenzhen, China</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>What we build</h2>
    </div>
    <div class="section-body prose">
      <p>
        Our current product is{' '}
        <a href="/products/samejob">Invoice Maker: SameJob</a>, an iOS app in
        development for solo service businesses in the United States. Its focus
        is reducing the work involved in creating invoices for repeat jobs.
      </p>
      <p>
        For company and product inquiries, <a href="/contact">get in touch</a>.
      </p>
    </div>
  </section>
</Layout>
