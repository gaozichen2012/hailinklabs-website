---
import Layout from '../layouts/Layout.astro';
import Product from '../components/Product.astro';
import { site } from '../data/site';
---

<Layout
  title="Hailink Labs — Focused software for everyday work"
  description="Hailink Labs is a software company based in Shenzhen, China. We build focused apps for everyday work, including Invoice Maker: SameJob."
>
  <section class="hero">
    <p class="eyebrow">Hailink Labs · Independent software</p>
    <h1>
      Focused software.
      <br />
      <span class="muted-heading">For everyday work.</span>
    </h1>
    <div class="hero-bottom">
      <p>
        We build practical apps with a simple purpose:
        <br class="desktop-break" /> make the work you do every day a little
        easier.
      </p>
      <a class="button" href="/products">
        Meet our products <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="products-section" aria-labelledby="products-title">
    <div class="section-label">
      <h2 id="products-title">Our products</h2>
    </div>
    <Product />
  </section>
  <section class="section-row company-section" aria-labelledby="company-title">
    <div class="section-label">
      <h2 id="company-title">The company</h2>
    </div>
    <div class="section-body">
      <p class="large-copy">
        Built in Shenzhen.
        <br />
        Designed for a global audience.
      </p>
      <p>
        Hailink Labs is a software company based in Shenzhen, China. We focus on
        simplicity, reliability, and a practical user experience.
      </p>
      <dl class="company-details">
        <div>
          <dt>Brand</dt>
          <dd>Hailink Labs</dd>
        </div>
        <div>
          <dt>Legal entity</dt>
          <dd lang="zh-Hans">{site.legalName}</dd>
        </div>
      </dl>
      <a class="text-link" href="/about">
        About Hailink Labs <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="section-row contact-section" aria-labelledby="contact-title">
    <div class="section-label">
      <h2 id="contact-title">Get in touch</h2>
    </div>
    <div class="section-body">
      <p class="large-copy">
        A question or an idea?
        <br />
        We’d like to hear it.
      </p>
      <a class="email-link" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
