---
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../data/site';
---

<Layout
  title="Invoice Maker: SameJob — Hailink Labs"
  description="Invoice Maker: SameJob is an iOS app in development for solo service businesses in the United States, focused on simplifying repeat invoices."
>
  <section class="page-intro product-intro">
    <a class="breadcrumb" href="/products">
      Products <span aria-hidden="true">/</span>
    </a>
    <p class="eyebrow">For iPhone · In development</p>
    <h1 class="product-title">
      <span class="product-category">Invoice Maker:</span>
      <span class="product-word">SameJob</span>
    </h1>
    <p class="intro-copy">Less work on the next invoice.</p>
  </section>
  <section class="product-story" aria-labelledby="repeat-title">
    <h2 id="repeat-title">Made for repeat work.</h2>
    <p>
      The same customer. The same service. SameJob is an iOS app in development
      for solo service businesses in the United States, built around a simple
      idea: less repeated entry, every time you invoice.
    </p>
    <div class="product-steps">
      <div>
        <h3>Start with a previous job.</h3>
        <p>Use the work you’ve already entered as your starting point.</p>
      </div>
      <div>
        <h3>Review what’s changed.</h3>
        <p>Keep the familiar details. Adjust what’s different for this job.</p>
      </div>
      <div>
        <h3>Prepare the next invoice.</h3>
        <p>
          Move from repeat work to the next invoice with less repeated entry.
        </p>
      </div>
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>Product information</h2>
    </div>
    <div class="section-body resource-links">
      <a href="/products/samejob/support">
        <span>
          <strong>SameJob support</strong>
          <span>Questions, feedback, and product help</span>
        </span>
        <span aria-hidden="true">→</span>
      </a>
      <a href="/products/samejob/privacy">
        <span>
          <strong>Privacy policy</strong>
          <span>How SameJob handles information</span>
        </span>
        <span aria-hidden="true">→</span>
      </a>
      <p class="quiet">
        In development by {site.name}. App Store availability will be shared
        here when the app is released.
      </p>
    </div>
  </section>
</Layout>
