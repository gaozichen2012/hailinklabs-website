---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout
  title="Contact — Hailink Labs"
  description="Contact Hailink Labs at gaozichen@hailinklabs.com for company inquiries and SameJob product support."
>
  <section class="page-intro">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch.</h1>
    <p class="intro-copy">
      Company inquiries, product questions,
      <br />
      or something you’d like to share.
    </p>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>Write to us</h2>
    </div>
    <div class="section-body prose">
      <a class="email-link" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">↗</span>
      </a>
      <dl class="company-details">
        <div>
          <dt>Brand</dt>
          <dd>{site.name}</dd>
        </div>
        <div>
          <dt>Legal entity</dt>
          <dd lang="zh-Hans">{site.legalName}</dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>Shenzhen, China</dd>
        </div>
      </dl>
      <p>
        Looking for help with Invoice Maker: SameJob? Visit{' '}
        <a href="/products/samejob/support">SameJob support</a>.
      </p>
    </div>
  </section>
</Layout>
