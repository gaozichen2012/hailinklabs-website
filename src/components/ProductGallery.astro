---
import type { Locale } from '../data/i18n';
import { productGalleries, screenshot } from '../data/screenshots';
interface Props {
  locale: Locale;
  slug: string;
  lead?: boolean;
}
const { locale, slug, lead = false } = Astro.props;
const allShots = productGalleries[slug];
const shots = lead ? allShots?.slice(0, 1) : allShots;
const galleryId = lead ? 'gallery-preview-title' : 'gallery-title';
---

{shots && (
  <section class="product-gallery" aria-labelledby={galleryId}>
    <h2 id={galleryId}>
      {lead
        ? locale === 'en'
          ? 'App preview'
          : 'App 界面预览'
        : locale === 'en'
          ? 'App screenshots'
          : 'App 截图'}
    </h2>
    <p>
      {locale === 'en'
        ? 'Actual app screens with example records. The app interface is in English.'
        : '真实 App 界面，记录为虚构示例；界面为英文。'}
    </p>
    <div class="screenshot-grid">
      {shots.map((shot) => (
        <figure>
          <a
            href={`/products/${slug}/${shot.file}.jpg`}
            aria-label={shot.caption[locale === 'en' ? 0 : 1]}
          >
            <img
              {...screenshot(`/products/${slug}/${shot.file}.jpg`)}
              sizes={
                lead
                  ? '220px'
                  : '(max-width: 760px) calc((100vw - 120px) / 2), (max-width: 1050px) calc((100vw - 260px) / 4), 244px'
              }
              loading={lead ? 'eager' : 'lazy'}
              decoding="async"
              alt={shot.caption[locale === 'en' ? 0 : 1]}
            />
          </a>
          <figcaption>{shot.caption[locale === 'en' ? 0 : 1]}</figcaption>
        </figure>
      ))}
    </div>
    {lead && (
      <a class="text-link" href="#gallery-title">
        {locale === 'en' ? 'View all screenshots' : '查看全部截图'} ↓
      </a>
    )}
  </section>
)}
