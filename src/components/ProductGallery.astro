---
import { type Copy } from '../data/products';
import type { Locale } from '../data/i18n';
import additional from '../data/product-galleries.json';
interface Props {
  locale: Locale;
  slug: string;
  lead?: boolean;
}
const { locale, slug, lead = false } = Astro.props;
const galleries: Record<
  string,
  readonly { file: string; caption: Copy; width?: number; height?: number }[]
> = {
  samejob: [
    {
      file: '01-repeat-invoices',
      caption: ['Start from a repeat customer', '从回头客的历史工作开始'],
    },
    {
      file: '02-reuse-job-details',
      caption: ['Review the customer and service', '核对客户与服务内容'],
    },
    {
      file: '03-preview-pdf',
      caption: ['Preview the finished invoice PDF', '预览生成的发票 PDF'],
    },
    {
      file: '04-keep-your-records',
      caption: ['Export and back up your records', '导出与备份记录'],
    },
  ],
  gearproof: [
    {
      file: '04-gearproof',
      caption: ['Start with your equipment', '从器材首页开始'],
    },
    {
      file: '01-multi-item-handoff',
      caption: ['Choose gear for a handoff', '选择本次交接的器材'],
    },
    {
      file: '02-reconcile-returns',
      caption: ['Check what came back', '逐项核对归还器材'],
    },
    {
      file: '03-handoff-history',
      caption: ['See returns and open issues', '查看归还记录与未解决异常'],
    },
  ],
};
const allShots:
  | readonly {
      file: string;
      caption: readonly string[];
      width?: number;
      height?: number;
    }[]
  | undefined = galleries[slug] || additional[slug as keyof typeof additional];
const shots = lead ? allShots?.slice(0, 1) : allShots;
const galleryId = lead ? 'gallery-preview-title' : 'gallery-title';
---

{shots && (
  <section class="product-gallery" aria-labelledby={galleryId}>
    <h2 id={galleryId}>
      {locale === 'en' ? 'See it in action' : '看看实际使用过程'}
    </h2>
    <p>
      {locale === 'en'
        ? 'Actual app screens from existing store submission assets. Example records shown.'
        : '来自 App Store 展示素材的真实 App 界面，使用示例记录；App 界面为英文。'}
    </p>
    <div class="screenshot-grid">
      {shots.map((shot) => (
        <figure>
          <a
            href={`/products/${slug}/${shot.file}.jpg`}
            aria-label={shot.caption[locale === 'en' ? 0 : 1]}
          >
            <img
              src={`/products/${slug}/${shot.file}.jpg`}
              width={shot.width || 663}
              height={shot.height || 1440}
              loading={shots.indexOf(shot) === 0 ? 'eager' : 'lazy'}
              decoding="async"
              alt={shot.caption[locale === 'en' ? 0 : 1]}
            />
          </a>
          <figcaption>{shot.caption[locale === 'en' ? 0 : 1]}</figcaption>
        </figure>
      ))}
    </div>
    {lead && (
      <a class="text-link" href="#gallery-title">
        {locale === 'en' ? 'View all screenshots' : '查看全部截图'} ↓
      </a>
    )}
  </section>
)}
