---
import type { Locale } from '../data/i18n';
interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const zh = locale === 'zh-CN';
---

{slug === 'turnmath' ? (
  <>
    <p>
      {zh
        ? 'Free Starter 免费不限时、不限次数，包含三模式、10 以内加法、Move Boost、Reroll、Manual 与朗读。'
        : 'Free Starter has no time or usage limit: all three modes, addition within 10, Move Boost, Reroll, Manual challenges and speech.'}
    </p>
    <p>
      {zh
        ? '$6.99 一次性 Lifetime Unlock 解锁其余数学级别、Shield、Bonus Point、全部节奏与更多设置。支持符合条件的家庭共享，无订阅、广告或计时试用。'
        : 'A $6.99 one-time Lifetime Unlock adds the remaining math levels, Shield, Bonus Point, all paces and more settings. Supports eligible Family Sharing. No subscriptions, ads or timed trial.'}
    </p>
  </>
) : slug === 'samejob' ? (
  <>
    <p>
      {zh
        ? '终身 Pro：$29.99，一次性购买，包含未来更新。也可选择 $1.49/月或 $14.99/年的 Pro 订阅。'
        : 'Lifetime Pro: $29.99 once, including future updates. Pro is also offered at $1.49/month or $14.99/year.'}
    </p>
    <p>
      {zh
        ? '免费方案每个自然月可确认合计 5 张发票和估价单。Pro 不限数量。没有七天试用；月度和年度订阅自动续费，终身购买不续费。无广告。'
        : 'Free includes 5 finalized invoices and estimates combined per calendar month. Pro removes that limit. There is no seven-day trial; monthly and yearly subscriptions renew automatically, while lifetime does not. No ads.'}
    </p>
  </>
) : slug === 'hybridloop' ? (
  <>
    <p>
      {zh
        ? '免费下载，完整免费试用 7 天，之后以 $19.99 一次性买断。无订阅、广告或训练数量限制。'
        : 'Free download. Try the full app free for 7 days, then unlock Lifetime with a $19.99 one-time purchase. No subscription, ads or workout limits.'}
    </p>
    <p>
      {zh
        ? '试用从首次运行开始，在本机记录，不会自动扣款。试用后，新训练需要终身解锁；历史、修正、导出、备份与已开始的训练仍可使用。'
        : 'The trial starts on first launch, is recorded locally and does not charge automatically. After the trial, new workouts require Lifetime; history, corrections, exports, backups and an already started workout remain available.'}
    </p>
  </>
) : slug === 'gearproof' ? (
  <>
    <p>
      {zh
        ? '完整免费试用 7 天，之后以 $19.99 一次性买断。无订阅、广告或器材数量配额。'
        : 'Try the full app free for 7 days, then unlock lifetime access with a $19.99 one-time purchase. No subscription, ads or gear quotas.'}
    </p>
    <p>
      {zh
        ? '试用从首次运行开始，在本机记录，不会自动扣款。购买及恢复购买需要连接 App Store。试用后仍可处理已有交接的归还、查看历史与导出。'
        : 'Your trial starts on first launch and is recorded locally. It does not charge automatically. Purchases and restoring purchases require the App Store. Existing returns, history and exports remain available after the trial.'}
    </p>
  </>
) : slug === 'tmproof' ? (
  <p>
    {zh
      ? '免费下载，完整免费试用 7 天，之后以 $9.99 一次性买断。无订阅、无广告、不限制工单数量，核心功能不拆分收费。'
      : 'Free download. Try the full app free for 7 days, then unlock it with a $9.99 one-time purchase. No subscription, no ads, no ticket limits and no separate charges for core features.'}
  </p>
) : (
  <>
    <p>
      {zh
        ? `免费完整试用 7 天，之后可一次性支付 ${slug === 'calvingpocket' ? '$19.99' : '$9.99'} 解锁。无订阅。`
        : `Try everything free for 7 days. Unlock the full app with a ${slug === 'calvingpocket' ? '$19.99' : '$9.99'} one-time purchase. No subscription.`}
    </p>
    <p>
      {zh
        ? '试用在你主动通过 App Store 确认后开始，不会自动扣款。无广告，解锁后核心功能无使用数量限制。首次激活及购买需连接 App Store。'
        : 'The trial starts when you choose it and confirm with the App Store. It does not charge automatically. No ads or usage limits on core features after unlock. Initial activation and purchases require an App Store connection.'}
    </p>
  </>
)}
<p class="quiet">
  {zh
    ? '以上为美元价格；购买时以 App Store 显示的当地价格为准。'
    : 'Prices shown in USD. The App Store displays the applicable local price before purchase.'}
</p>
