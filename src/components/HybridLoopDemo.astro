---
import type { Locale } from '../data/i18n';

const { locale, workoutGuidePath } = Astro.props as {
  locale: Locale;
  workoutGuidePath?: string;
};
const c = (en: string, zh: string) => (locale === 'en' ? en : zh);
const video = '/products/hybridloop/workout-walkthrough.mp4';
---

<section id="hybridloop-demo" aria-labelledby="hybridloop-demo-title">
  <h2 id="hybridloop-demo-title">
    {c('Import, time and repeat a workout', '导入、计时与复练')}
  </h2>
  {workoutGuidePath && (
    <p>
      <a href={workoutGuidePath}>
        {c(
          'Follow the first-workout guide and copy the sample plan',
          '查看首练指南并复制示例计划',
        )}
      </a>
    </p>
  )}
  <video
    controls
    playsinline
    width="720"
    height="1280"
    preload="none"
    poster="/products/hybridloop/workout-walkthrough.jpg"
    aria-label={c('HybridLoop workout walkthrough', 'HybridLoop 训练流程演示')}
  >
    <source src={video} type="video/mp4" />
  </video>
  <p>
    {c(
      'Silent walkthrough made from existing App Store screenshots with sample data. The App interface is in English.',
      '无声演示以现有 App Store 截图制作，使用示例数据。App 界面为英文。',
    )}
    <a href={video} download>
      {c('Download the video', '下载视频')}
    </a>
  </p>
  <h3>{c('What the video shows', '演示中的四个步骤')}</h3>
  <ol>
    <li>
      {c(
        'Import the workout. From Train, open Import Workout to start with your plan.',
        '导入训练。在 Train 页面打开 Import Workout，从自己的计划开始。',
      )}
    </li>
    <li>
      {c(
        'Review the draft. On Build Workout, check the rounds, targets and timing rule before saving.',
        '核对草稿。在 Build Workout 页面检查轮数、目标及计时规则，然后保存。',
      )}
    </li>
    <li>
      {c(
        'Follow the timer. The screen shows the current task and what comes next. Use Complete · Next to move on.',
        '跟随计时。界面显示当前任务和下一项。完成后点 Complete · Next 继续。',
      )}
    </li>
    <li>
      {c(
        'Review the result. Workout Review shows the recorded time. Choose Repeat Original Plan to reuse the same plan.',
        '复盘成绩。在 Workout Review 查看记录用时。下次可点 Repeat Original Plan 复用原计划。',
      )}
    </li>
  </ol>
</section>

<style>
  video {
    display: block;
    width: min(100%, 380px);
    height: auto;
    border-radius: 18px;
  }
</style>
