---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';

import {
  translator,
  localizedPath,
  companyName,
  type Locale,
} from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---

<Layout
  locale={locale}
  title={t('Contact — Hailink Labs')}
  description={t(
    'Contact Hailink Labs at gaozichen@hailinklabs.com for company inquiries and SameJob product support.',
  )}
>
  <section class="page-intro">
    <p class="eyebrow">{t('Contact')}</p>
    <h1>{t('Get in touch.')}</h1>
    <p class="intro-copy">
      {t('Company inquiries, product questions,')}
      <br />
      {t('or something you’d like to share.')}
    </p>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{t('Write to us')}</h2>
    </div>
    <div class="section-body prose">
      <a class="email-link" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">↗</span>
      </a>
      <dl class="company-details">
        <div>
          <dt>{t('Brand')}</dt>
          <dd>{site.name}</dd>
        </div>
        <div>
          <dt>{t('Legal entity')}</dt>
          <dd>{companyName(locale)}</dd>
        </div>
        <div>
          <dt>{t('Location')}</dt>
          <dd>{t('Shenzhen, China')}</dd>
        </div>
      </dl>
      <p>
        {t('Looking for help with Invoice Maker: SameJob? Visit')}{' '}
        <a href={href('/products/samejob/support')}>{t('SameJob support')}</a>
        {locale === 'zh-CN' ? '。' : '.'}
      </p>
    </div>
  </section>
</Layout>
