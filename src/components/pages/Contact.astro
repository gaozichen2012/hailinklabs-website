---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';

import {
  translator,
  localizedPath,
  companyName,
  type Locale,
} from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---

<Layout
  locale={locale}
  title={t('Contact — Hailink Labs')}
  description={
    locale === 'en'
      ? 'Contact Hailink Labs for company inquiries and support for SameJob, TMProof, LitterRound and CalvingPocket.'
      : '联系 Hailink Labs，获取公司咨询及 SameJob、TMProof、LitterRound、CalvingPocket 产品支持。'
  }
>
  <section class="page-intro">
    <p class="eyebrow">{t('Contact')}</p>
    <h1>{t('Get in touch.')}</h1>
    <p class="intro-copy">
      {t('Company inquiries, product questions,')}
      <br />
      {t('or something you’d like to share.')}
    </p>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{t('Write to us')}</h2>
    </div>
    <div class="section-body prose">
      <a class="email-link" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">↗</span>
      </a>
      <dl class="company-details">
        <div>
          <dt>{t('Brand')}</dt>
          <dd>{site.name}</dd>
        </div>
        <div>
          <dt>{t('Legal entity')}</dt>
          <dd>{companyName(locale)}</dd>
        </div>
        <div>
          <dt>{t('Location')}</dt>
          <dd>{t('Shenzhen, China')}</dd>
        </div>
      </dl>
      <p>
        {locale === 'en'
          ? 'For help with an app, choose it from our '
          : '如需 App 使用帮助，请从'}
        <a href={href('/products')}>
          {locale === 'en' ? 'products' : '产品目录'}
        </a>
        {locale === 'en'
          ? ' to find its support and privacy pages.'
          : '进入相应的支持与隐私页面。'}
      </p>
    </div>
  </section>
</Layout>
