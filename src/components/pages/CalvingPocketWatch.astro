---
import Layout from '../../layouts/Layout.astro';
import CalvingDemo from '../CalvingDemo.astro';
import AppStoreLink from '../AppStoreLink.astro';
import { calvingpocketDemo as demo } from '../../data/calvingpocket-demo';
import { copy } from '../../data/products';
import { localizedPath, type Locale } from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = (en: string, zh: string) => (locale === 'en' ? en : zh);
const link = (path: string) => localizedPath(path, locale);
---

<Layout
  locale={locale}
  title={`${copy(demo.title, locale)} | Hailink Labs`}
  description={copy(demo.description, locale)}
>
  <article class="watch-page">
    <a class="breadcrumb" href={link('/products/calvingpocket')}>
      CalvingPocket · {c('Product information', '产品介绍')}
    </a>
    <h1>{copy(demo.title, locale)}</h1>
    <CalvingDemo locale={locale} watchPage />
    <section id="transcript">
      <h2>
        {c('Video transcript and visual walkthrough', '视频字幕与画面步骤说明')}
      </h2>
      <p>
        {c(
          'This is a silent recording. Each heading below reproduces or describes a video chapter; the text explains the visible action. The example is fictional, not a customer testimonial.',
          '视频无旁白。下方标题对应视频章节，文字说明可见操作。示例为虚构数据，不是客户证言。',
        )}
      </p>
      <ol class="transcript">
        {demo.segments.map((segment) => (
          <li>
            <h3>
              <a href={`${demo.video}#t=${segment.start},${segment.end}`}>
                {segment.time}
              </a>{' '}
              · {copy(segment.title, locale)}
            </h3>
            <p>{copy(segment.text, locale)}</p>
          </li>
        ))}
      </ol>
    </section>
    <section>
      <h2>
        {c(
          'Prepare your calving book before heading out',
          '出发前准备好产犊记录本',
        )}
      </h2>
      <p>
        {c(
          'Activate the seven-day free trial or restore existing access while online, then record calves offline with active access. The trial does not renew or charge automatically. Read the product page for lifetime pricing, exports and full backups.',
          '请先联网激活七天免费试用，或恢复已有购买，确认访问权限有效后即可离线记录。试用不会自动续费或扣款。终身价格、导出与完整备份详情见产品页。',
        )}
      </p>
      <AppStoreLink locale={locale} slug="calvingpocket" />
      <ul>
        <li>
          <a href={link('/products/calvingpocket')}>
            {c(
              'CalvingPocket features, pricing and common questions',
              'CalvingPocket 功能、价格与常见问题',
            )}
          </a>
        </li>
        <li>
          <a href={link('/guides/offline-calving-records')}>
            {c('Prepare to record calves offline', '准备离线记录犊牛')}
          </a>
        </li>
        <li>
          <a href={link('/templates/calving-record-sheet')}>
            {c('Get the free printable calving sheet', '获取免费可打印产犊表')}
          </a>
        </li>
      </ul>
    </section>
  </article>
</Layout>
<style>
  .watch-page {
    max-width: 820px;
    margin: 2rem auto 4rem;
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1.15;
  }
  section {
    margin-block: 2.5rem;
  }
  .transcript {
    padding-left: 1.5rem;
  }
  li {
    margin-block: 1rem;
  }
</style>
