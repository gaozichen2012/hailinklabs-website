---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
interface Props {
  kind: 'privacy' | 'support';
}
const { kind } = Astro.props;
const title = kind === 'privacy' ? 'SeamCarry 隐私政策' : 'SeamCarry 支持';
---

<Layout
  locale="zh-CN"
  title={`${title} — Hailink Labs`}
  description="SeamCarry 本地纸样记录、实物版本核对、备份和购买支持。"
>
  <section class="section intro">
    <p class="eyebrow">Hailink Labs · SeamCarry</p>
    <h1>{title}</h1>
  </section>
  <article class="policy prose">
    {kind === 'privacy' ? (
      <>
        <p>
          生效日期：2026年10月7日。SeamCarry 1.0。中文便于阅读，如有差异以
          <a href="/products/seamcarry/privacy">英文版本</a>为准。
        </p>
        <h2>本地记录与照片</h2>
        <p>
          纸样、修改、实物版本、制作快照、笔记和照片副本保存在设备上。无账号、广告、分析、追踪、AI
          上传或用户内容服务器。Hailink Labs 不通过 App 接收这些记录。
        </p>
        <h2>可选照片权限</h2>
        <p>
          照片选择使用系统选择器，仅选择拍照时请求相机权限。拒绝权限仍可用文字记录。导入照片是独立
          App 副本，删除相册原图不会删除此副本。
        </p>
        <h2>Apple 与文件服务</h2>
        <p>
          Apple 通过 StoreKit
          处理购买和恢复购买，验证权益保存在本地；备份不含购买凭证。PDF、CSV、完整备份的目的地和接收方由你选择，Files
          提供商按自身政策传输。iCloud Drive
          是文件备份，不是自动数据库同步。完整备份可能包含原始照片和元数据，请作为私人文件保管；SeamCarry
          不额外加密备份。
        </p>
        <h2>保留与删除</h2>
        <p>
          回收站保留删除的纸样至少30天，永久删除前仍保留。历史快照、备份和本地恢复点可能保留较早记录。你可以编辑、导出和删除资料。没有离机备份时，卸载、设备丢失或损坏可能丢失数据。恢复购买恢复权益，不恢复纸样资料。
        </p>
        <h2>网站与支持邮件</h2>
        <p>
          网站由 GitHub Pages
          托管，可能按自身隐私声明处理连接和请求信息。网站无广告、分析、联系表单或追踪
          Cookie。自愿发送的支持邮件和资料用于回应请求，与 App
          本地资料分开，沿用
          <a href="/zh/products/samejob/privacy">公司支持邮件政策</a>
          。除非必要且主动选择分享，请勿发送私人照片或完整备份。
        </p>
        <p>
          <a href="https://www.apple.com/legal/privacy/">Apple 隐私政策</a> ·{' '}
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">
            GitHub 隐私声明
          </a>
        </p>
      </>
    ) : (
      <>
        <h2>裁布前核对实物</h2>
        <p>
          创建纸样，用短码标记实物。修改先记为待核对，在这份纸样实际落实后确认
          Applied，不采用则填写原因。封存版本和每次新制作前核对标签、款式和尺寸。Ready
          记录你的确认，不认证合体或几何正确；新版复制笔记但需要重新确认。
        </p>
        <h2>历史与备份</h2>
        <p>
          制作快照保留当时版本。PDF、CSV 是报告，不是原比例纸样或可恢复备份。在
          Settings 创建完整 .seamcarry
          备份并保存到设备之外。恢复先验证和预览、生成本地检查点，再替换整库；不合并资料或转移购买权益。恢复前保留当前离机备份。
        </p>
        <h2>两套免费，可选 Lifetime</h2>
        <p>
          两套纸样包含所有功能。归档计额度，回收站和独立示例不计。美国 Lifetime
          非消耗型买断 US$9.99 解锁无限新建，实际价格由 Apple
          显示，无订阅。退款或商店临时错误不影响查看、编辑、导出和备份已有记录。恢复购买使用你的
          App Store 账号。
        </p>
        <h2>保存与帮助</h2>
        <p>
          保存失败时保留资料、检查可用空间并重试，不要卸载或清空数据。拍照可选，也可选择照片或只用文字。请向支持邮箱提供版本、操作和准确错误。除非主动决定为支持分享，不要发送私人照片或完整备份。
        </p>
      </>
    )}
    <p>
      <a href={`mailto:${site.email}?subject=SeamCarry%20Support`}>
        {site.email}
      </a>
    </p>
    <p>
      <a href="/zh/products/seamcarry/support">支持</a> ·{' '}
      <a href="/zh/products/seamcarry/privacy">隐私政策</a> ·{' '}
      <a href="/zh/contact">联系 Hailink Labs</a>
    </p>
  </article>
</Layout>
