---
import BrandLogo from '../BrandLogo.astro';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';

import {
  translator,
  localizedPath,
  companyName,
  type Locale,
} from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---

<Layout
  locale={locale}
  title={t('About — Hailink Labs')}
  description={t(
    'Hailink Labs is the software brand of Shenzhen Hailink Technology Co., Ltd., based in Shenzhen, China.',
  )}
>
  <section class="page-intro">
    <p class="eyebrow">{t('About Hailink Labs')}</p>
    <h1>
      {t('Small details.')}
      <br />
      <span class="muted-heading">{t('Everyday value.')}</span>
    </h1>
    <p class="intro-copy">
      {t('We build focused software around practical needs.')}
    </p>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{t('Who we are')}</h2>
    </div>
    <div class="section-body prose">
      <div class="about-brand">
        <BrandLogo />
      </div>
      <p>
        {t(
          'Hailink Labs is a software company based in Shenzhen, China. Hailink Labs is the brand of',
        )}{' '}
        <span>{companyName(locale)}</span>
        {locale === 'zh-CN' ? '。' : ''}
      </p>
      <p>
        {t(
          'Our work centers on useful apps with clear workflows and a considered user experience. We value simplicity and reliability in both the software we build and the way we maintain it.',
        )}
      </p>
      <dl class="company-details">
        <div>
          <dt>{t('Brand')}</dt>
          <dd>{site.name}</dd>
        </div>
        <div>
          <dt>{t('Legal entity')}</dt>
          <dd>{companyName(locale)}</dd>
        </div>
        <div>
          <dt>{t('Location')}</dt>
          <dd>{t('Shenzhen, China')}</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{t('What we build')}</h2>
    </div>
    <div class="section-body prose">
      <p>
        {locale === 'en'
          ? 'We build focused apps for work and business, animal records, training, and family learning. Each app starts with a practical need and keeps its purpose clear. '
          : '我们围绕工作与业务、动物记录、运动训练和家庭学习打造专注实用的 App。每款产品从具体需求出发，把一件事做好。'}
        <a href={href('/products')}>
          {locale === 'en' ? 'Explore our products' : '了解我们的产品'}
        </a>
      </p>
      <p>
        {t('For company and product inquiries,')}{' '}
        <a href={href('/contact')}>{t('get in touch')}</a>
        {locale === 'zh-CN' ? '。' : '.'}
      </p>
    </div>
  </section>
  <section class="section-row" id="content-method">
    <div class="section-label">
      <h2>
        {locale === 'en'
          ? 'How we maintain our resources'
          : '资源制作与维护方法'}
      </h2>
    </div>
    <div class="section-body prose">
      <p>
        {locale === 'en'
          ? 'Hailink Labs maintains these guides and templates. Our record workflows are practical suggestions, with fictional examples clearly labeled. Product behavior is checked against product and support documentation; store availability and purchase options use current Apple listings.'
          : '指南与模板由 Hailink Labs 维护。记录组织流程是我们的实用建议，虚构示例明确标识。产品行为依据产品与支持资料核对，商店供应及购买选项依据当前 Apple 信息。'}
      </p>
      <p>
        {locale === 'en'
          ? 'Free worksheet examples are independent documents. Actual app screenshots are labeled with their source. A file is described as an app export only when its origin can be verified. Content dates change when that content is maintained; checks and deployment do not prove customer outcomes.'
          : '免费工作表填写示例是独立文档；真实 App 截图标明来源。只有可核验来源的文件才称为 App 导出。内容维护后更新相应日期；检查和部署不证明客户业务效果。'}
      </p>
    </div>
  </section>
</Layout>
