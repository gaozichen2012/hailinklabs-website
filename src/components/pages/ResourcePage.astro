---
import Layout from '../../layouts/Layout.astro';
import AppStoreLink from '../AppStoreLink.astro';
import { guides, templates, hubs, resourceText } from '../../data/resources';
import { catalog, highlights } from '../../data/catalog';
import { localizedPath, type Locale } from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/^\/zh/, '')
    .replace(/\/$/, '') || '/';
const guide = guides.find((g) => path === `/guides/${g.slug}`);
const sheet = templates.find((t) => path === `/templates/${t.slug}`);
const hub = hubs.find((h) => path === `/guides/${h.slug}`);
const resource = guide || sheet;
const product = resource && catalog.find((p) => p.slug === resource.app);
const template = guide
  ? templates.find((t) => t.slug === guide.template)
  : sheet;
const c = (en: string, zh: string) => (locale === 'en' ? en : zh);
const d = (value: readonly string[]) => resourceText(value, locale);
const link = (target: string) => localizedPath(target, locale);
const isTemplates = path.startsWith('/templates');
const title = resource
  ? d(resource.title)
  : hub
    ? d(hub.title)
    : isTemplates
      ? c('Free Templates', '免费模板')
      : c('Guides & Resources', '指南与资源');
const description = resource
  ? d(resource.description)
  : hub
    ? d(hub.intro)
    : c(
        'Practical guides and free record templates for contractors, small teams, animal carers, heat press makers and solo service businesses. No registration required.',
        '面向承包商、小团队、动物照护者、热压制作者和个人服务经营者的实用指南与免费记录模板，提供可打印及电子表格资源，无需注册。',
      );
const guideList = hub ? guides.filter((g) => g.category === hub.slug) : guides;
const templateList = hub
  ? templates.filter((t) => guideList.some((g) => g.app === t.app))
  : templates;
---

<Layout
  locale={locale}
  title={`${title}${sheet ? c(' — Free PDF & CSV', ' — 免费 PDF 与 CSV') : ''} | Hailink Labs`}
  description={description}
>
  <article class="resource-page">
    <nav class="resource-breadcrumb" aria-label={c('Breadcrumb', '面包屑导航')}>
      <a href={link('/')}>Hailink Labs</a>
      <span aria-hidden="true">/</span>
      <a href={link(isTemplates ? '/templates' : '/guides')}>
        {c(
          isTemplates ? 'Free Templates' : 'Guides',
          isTemplates ? '免费模板' : '指南',
        )}
      </a>
      {guide && (
        <>
          <span aria-hidden="true">/</span>
          <a href={link(`/guides/${guide.category}`)}>
            {d(hubs.find((h) => h.slug === guide.category)!.title)}
          </a>
        </>
      )}
    </nav>
    <header class="resource-intro">
      <p class="eyebrow">
        {c('Practical records. Clear answers.', '实用记录，清楚解答。')}
      </p>
      <h1>{title}</h1>
      <p class={guide ? 'quick-answer' : 'resource-description'}>
        {guide ? d(guide.answer) : description}
      </p>
      {resource && (
        <p class="resource-dates">
          {c('Published', '发布')}{' '}
          <time datetime={resource.publishedAt}>{resource.publishedAt}</time> ·{' '}
          {c('Last updated', '更新')}{' '}
          <time datetime={resource.updatedAt}>{resource.updatedAt}</time>
        </p>
      )}
    </header>
    {guide && (
      <div class="resource-body">
        <section>
          <h2>{c('What this record means', '这项记录是什么')}</h2>
          <p>{d(guide.definition)}</p>
        </section>
        <section>
          <h2>{c('Who is this for?', '适合谁使用？')}</h2>
          <p>{d(guide.audience)}</p>
        </section>
        <section>
          <h2>{c('What should be recorded?', '应该记录什么？')}</h2>
          <p>
            {c(
              'Use this review checklist before sharing your record.',
              '分享记录前，用下面的清单核对。',
            )}
          </p>
          <div class="record-table-wrap">
            <table class="record-table">
              <caption>{c('Record review checklist', '记录核对清单')}</caption>
              <thead>
                <tr>
                  <th scope="col">{c('Check', '核对')}</th>
                  <th scope="col">{c('Information', '信息')}</th>
                </tr>
              </thead>
              <tbody>
                {guide.fields.map((f) => (
                  <tr>
                    <td aria-label={c('To check', '待核对')}>□</td>
                    <th scope="row">{d(f)}</th>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <section>
          <h2>{c('Example', '示例')}</h2>
          <p class="example-note">{d(guide.example)}</p>
        </section>
        <section>
          <h2>{c('Step-by-step workflow', '分步流程')}</h2>
          <ol>
            {guide.steps.map((s) => (
              <li>{d(s)}</li>
            ))}
          </ol>
        </section>
        <section>
          <h2>{c('Common mistakes', '常见错误')}</h2>
          <ul>
            {guide.mistakes.map((m) => (
              <li>{d(m)}</li>
            ))}
          </ul>
        </section>
        <section>
          <h2>
            {c('Paper, spreadsheet or iPhone?', '纸面、电子表格还是 iPhone？')}
          </h2>
          <p>
            {c(
              'Paper works at a handover without a device. CSV makes rows easy to sort in Excel, Numbers or Google Sheets, but you must manage revisions and copies. An iPhone app can keep related records together; choose it when its documented workflow fits your needs. None of these formats removes the need to verify the original entry or keep a backup.',
              '纸面适合无需设备的交接。CSV 可在 Excel、Numbers 或 Google Sheets 中排序，但修订和副本需要自己管理。iPhone App 可以集中关联记录，当其已说明流程适合你时再选择。无论哪种格式，都需要核对原始记录并保留备份。',
            )}
          </p>
        </section>
        {template && (
          <section class="free-resource">
            <h2>{c('Free Template', '免费模板')}</h2>
            <p>{d(template.description)}</p>
            <a class="button" href={link(`/templates/${template.slug}`)}>
              {c(
                'View, print or download the template',
                '查看、打印或下载模板',
              )}
            </a>
          </section>
        )}
        <section>
          <h2>{c('Frequently asked questions', '常见问题')}</h2>
          {guide.faq.map((f) => (
            <div class="resource-faq">
              <h3>{d(f.question)}</h3>
              <p>{d(f.answer)}</p>
            </div>
          ))}
        </section>
        <section>
          <h2>{c('Sources & scope', '来源与范围')}</h2>
          <p>
            {c(
              'Original workflow suggestions by Hailink Labs. Examples are illustrative, not customer records or industry standards. App descriptions are based on the public product and support pages below; the free worksheet is a separate resource and does not imply that every field is an app feature.',
              'Hailink Labs 原创流程建议。示例为说明用途，不是客户记录或行业标准。App 说明依据下方公开产品与支持页；免费工作表为独立资源，不代表每个字段都是 App 功能。',
            )}
          </p>
          <ul>
            <li>
              <a href={link(`/products/${guide.app}`)}>
                {product?.name} — {c('product information', '产品说明')}
              </a>
            </li>
            <li>
              <a href={link(`/products/${guide.app}/support`)}>
                {product?.name} — {c('support documentation', '使用支持')}
              </a>
            </li>
          </ul>
        </section>
      </div>
    )}
    {sheet && (
      <div class="resource-body">
        <section class="free-resource">
          <h2>{c('Download or print', '下载或打印')}</h2>
          <p>
            {c(
              'Free to use. No account, email address or registration. Use your browser’s Print command to print this HTML sheet. English PDF and English/Chinese CSV downloads are available below. CSV has blank rows and no formulas; review your entries and calculations.',
              '免费使用，无需账号、邮箱或注册。使用浏览器“打印”命令打印本 HTML 表。下方提供英文 PDF 和中英文 CSV；CSV 含空白行，不含公式，填写与计算请自行核对。',
            )}
          </p>
          <div class="resource-downloads">
            <a class="button" href={`/downloads/${sheet.slug}.pdf`} download>
              {c('Download PDF (English)', '下载 PDF（英文）')}
            </a>
            <a
              class="button secondary"
              href={`/downloads/${sheet.slug}${locale === 'en' ? '' : '-zh'}.csv`}
              download
            >
              {c('Download CSV', '下载中文 CSV')}
            </a>
            {locale !== 'en' && (
              <a
                class="text-link"
                href={`/downloads/${sheet.slug}.csv`}
                download
              >
                English CSV
              </a>
            )}
          </div>
        </section>
        <section class="print-sheet">
          <h2>{d(sheet.title)}</h2>
          <p>{d(sheet.note)}</p>
          <table class="record-table">
            <caption>
              {c(
                'Blank record sheet — use additional copies for more entries',
                '空白记录表 — 更多记录可使用附页',
              )}
            </caption>
            <thead>
              <tr>
                <th scope="col">{c('Field', '字段')}</th>
                <th scope="col">{c('Your record', '填写记录')}</th>
              </tr>
            </thead>
            <tbody>
              {sheet.fields.map((f) => (
                <tr>
                  <th scope="row">{d(f)}</th>
                  <td>
                    <span aria-hidden="true">________________</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
        <section>
          <h2>{c('How to use the sheet', '如何使用')}</h2>
          <ol>
            <li>
              {c(
                'Choose HTML for printing, PDF for a saved printable copy or CSV for a spreadsheet.',
                '打印可用 HTML，保存打印副本可用 PDF，电子表格可用 CSV。',
              )}
            </li>
            <li>
              {c(
                'Use one clearly identified record per entry. Include units, dates and names where the field asks for them.',
                '每条记录明确标识，并按字段要求注明单位、日期和姓名。',
              )}
            </li>
            <li>{d(sheet.note)}</li>
            <li>
              {c(
                'Check the completed record before sharing it and keep a separate saved copy.',
                '分享前核对填好的记录，另外保留已保存副本。',
              )}
            </li>
          </ol>
        </section>
        <section>
          <h2>{c('Guides for this template', '本模板相关指南')}</h2>
          <ul>
            {guides
              .filter((g) => g.app === sheet.app)
              .map((g) => (
                <li>
                  <a href={link(`/guides/${g.slug}`)}>{d(g.title)}</a>
                </li>
              ))}
          </ul>
        </section>
        <section>
          <h2>{c('Related Templates', '相关模板')}</h2>
          <ul>
            {templates
              .filter((t) => t.slug !== sheet.slug)
              .map((t) => (
                <li>
                  <a href={link(`/templates/${t.slug}`)}>{d(t.title)}</a>
                </li>
              ))}
          </ul>
        </section>
      </div>
    )}
    {product && resource && (
      <aside class="related-app resource-body">
        <h2>
          {c('Keep these records on your iPhone', '在 iPhone 上保存这些记录')}
        </h2>
        <p>{d(product.description)}</p>
        <p>{d(highlights[product.slug].data)}</p>
        <a class="text-link" href={link(`/products/${product.slug}`)}>
          {c('Explore', '了解')} {product.name}{' '}
          <span aria-hidden="true">→</span>
        </a>
        <AppStoreLink
          locale={locale}
          slug={product.slug}
          source={guide ? 'guide' : 'template'}
          content={resource.slug}
        />
      </aside>
    )}
    {guide && (
      <section class="resource-body">
        <h2>{c('Related Guides', '相关指南')}</h2>
        <ul>
          {guides
            .filter((g) => g.app === guide.app && g.slug !== guide.slug)
            .map((g) => (
              <li>
                <a href={link(`/guides/${g.slug}`)}>{d(g.title)}</a>
              </li>
            ))}
        </ul>
      </section>
    )}
    {!resource && (
      <div class="resource-body resource-index">
        {hub && (
          <>
            <section>
              <h2>{c('A practical record workflow', '实用记录流程')}</h2>
              <p>{d(hub.workflow)}</p>
            </section>
            <section>
              <h2>{c('Common questions', '常见问题')}</h2>
              {hub.questions.map(([q, a]) => (
                <div class="resource-faq">
                  <h3>{d(q)}</h3>
                  <p>{d(a)}</p>
                </div>
              ))}
            </section>
          </>
        )}
        {!hub && !isTemplates && (
          <section>
            <h2>{c('Browse by task', '按任务浏览')}</h2>
            <div class="resource-grid">
              {hubs.map((h) => (
                <a class="resource-card" href={link(`/guides/${h.slug}`)}>
                  <h3>{d(h.title)}</h3>
                  <p>{d(h.intro)}</p>
                </a>
              ))}
            </div>
          </section>
        )}
        {!isTemplates && (
          <section>
            <h2>{c('Search-intent guides', '问题指南')}</h2>
            <div class="resource-grid">
              {guideList.map((g) => (
                <a class="resource-card" href={link(`/guides/${g.slug}`)}>
                  <h3>{d(g.title)}</h3>
                  <p>{d(g.answer)}</p>
                </a>
              ))}
            </div>
          </section>
        )}
        <section>
          <h2>{c('Free Templates', '免费模板')}</h2>
          <p>
            {c(
              'HTML, English PDF and bilingual CSV. No registration required.',
              'HTML、英文 PDF 和双语 CSV，无需注册。',
            )}
          </p>
          <div class="resource-grid">
            {templateList.map((t) => (
              <a class="resource-card" href={link(`/templates/${t.slug}`)}>
                <h3>{d(t.title)}</h3>
                <p>{d(t.description)}</p>
              </a>
            ))}
          </div>
        </section>
        {hub && (
          <section>
            <h2>{c('Related Apps', '相关 App')}</h2>
            <ul>
              {templateList.map((t) => (
                <li>
                  <a href={link(`/products/${t.app}`)}>
                    {catalog.find((p) => p.slug === t.app)?.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <p>
          <a href={link(isTemplates ? '/guides' : '/templates')}>
            {c(
              isTemplates
                ? 'Browse Guides & Resources'
                : 'Browse all Free Templates',
              isTemplates ? '浏览指南与资源' : '浏览全部免费模板',
            )}
          </a>
        </p>
      </div>
    )}
  </article>
</Layout>
