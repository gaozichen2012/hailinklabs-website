---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import copy from '../../data/cueladder.json';
interface Props {
  locale?: 'en' | 'zh-CN';
  kind: 'privacy' | 'support';
}
const { kind, locale = 'en' } = Astro.props;
const c = (en: string, zh: string) => (locale === 'en' ? en : zh);
const prefix = locale === 'en' ? '' : '/zh';
const title =
  kind === 'privacy'
    ? c('CueLadder Privacy Policy', 'CueLadder 隐私政策')
    : c('CueLadder Support', 'CueLadder 支持');
const description =
  kind === 'privacy'
    ? c(
        'How CueLadder handles local pieces, landmarks and practice history, Apple purchases, user-directed exports and support correspondence.',
        'CueLadder 本地曲目、路标和历史、Apple 购买、用户主动导出与支持邮件处理说明。',
      )
    : c(
        'Help with landmarks, Checks, Practice, Forward Recovery and CSV exports, local backups and purchase restoration in CueLadder.',
        'CueLadder 路标、检查、练习、恢复与 CSV 导出、本地备份和恢复购买帮助。',
      );
---

<Layout
  locale={locale}
  title={`${title} — Hailink Labs`}
  description={description}
>
  <section class="section intro">
    <a class="breadcrumb" href={`${prefix}/products/cueladder`}>
      {c('CueLadder product information', 'CueLadder 产品介绍')}
    </a>
    <p class="eyebrow">Hailink Labs · CueLadder</p>
    <h1>{title}</h1>
  </section>
  <article class="policy prose">
    {locale === 'zh-CN' && kind === 'privacy' && (
      <p>
        中文版本方便阅读，如有差异以
        <a href="/products/cueladder/privacy">英文版本</a>为准。
      </p>
    )}
    <Fragment set:html={copy[kind][locale]} />
    {kind === 'privacy' && (
      <>
        <h2>{c('Website and support correspondence', '网站与支持邮件')}</h2>
        <p>
          {c(
            'This website is hosted by GitHub Pages, whose service may process connection and request information under its own privacy statement. The website has no advertising, analytics, contact form or tracking cookies. Voluntary support email follows the existing company support policy and is separate from local practice records.',
            '网站由 GitHub Pages 托管，托管方按自身隐私声明处理连接和请求资料。网站无广告、分析、联系表单或追踪 Cookie。自愿发送的支持邮件沿用公司支持政策，与本地练习记录分开。',
          )}
        </p>
        <p>
          <a href="https://www.apple.com/legal/privacy/">
            Apple Privacy Policy
          </a>{' '}
          ·{' '}
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">
            GitHub Privacy Statement
          </a>{' '}
          ·{' '}
          <a href={`${prefix}/products/samejob/privacy`}>
            {c('Company support correspondence policy', '公司支持邮件政策')}
          </a>
        </p>
      </>
    )}
    <p>
      <a href={`mailto:${site.email}?subject=CueLadder%20Support`}>
        {site.email}
      </a>
    </p>
    <p>
      <a href={`${prefix}/products/cueladder/support`}>
        {c('Support', '支持')}
      </a>{' '}
      ·{' '}
      <a href={`${prefix}/products/cueladder/privacy`}>
        {c('Privacy policy', '隐私政策')}
      </a>{' '}
      ·{' '}
      <a href={`${prefix}/contact`}>
        {c('Contact Hailink Labs', '联系 Hailink Labs')}
      </a>
    </p>
  </article>
</Layout>
