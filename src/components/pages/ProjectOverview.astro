---
import Layout from '../../layouts/Layout.astro';
import { availability } from '../../data/catalog';
import { copy } from '../../data/products';
import { localizedPath, type Locale } from '../../data/i18n';
import type { ProjectProduct } from '../../data/project-products';
interface Props {
  locale: Locale;
  product: ProjectProduct;
}
const { locale, product: p } = Astro.props;
const c = (value: readonly [string, string]) => copy(value, locale);
const href = (suffix: string) =>
  localizedPath(`/products/${p.slug}${suffix}`, locale);
---

<Layout
  locale={locale}
  title={`${p.name} — ${c(p.subtitle)} | Hailink Labs`}
  description={c(p.description)}
>
  <section class="page-intro product-intro">
    <a class="breadcrumb" href={localizedPath('/products', locale)}>
      {c(['Products', '产品'])} <span aria-hidden="true">/</span>
    </a>
    <p class="eyebrow">{c(['For iPhone', '适用于 iPhone'])}</p>
    <h1 class="matrix-title" lang="en">
      {p.storeName}
    </h1>
    <p class="intro-copy">{c(p.subtitle)}</p>
    <p class="product-positioning">{c(p.description)}</p>
    <p class="availability">{c(availability(p.slug))}</p>
    <a class="text-link" href="#pricing">
      {c(['Pricing details', '详细收费规则'])} <span aria-hidden="true">↓</span>
    </a>
  </section>
  <section class="product-story">
    <h2>{c(p.value)}</h2>
    <div class="product-steps">
      {p.steps.map(([heading, body]) => (
        <div>
          <h3>{c(heading)}</h3>
          <p>{c(body)}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{c(['Scope and checks', '范围与核对'])}</h2>
    </div>
    <div class="section-body">
      <p>{c(p.scope)}</p>
    </div>
  </section>
  <section class="section-row" id="pricing">
    <div class="section-label">
      <h2>{c(['Free access and purchases', '免费与购买'])}</h2>
    </div>
    <div class="section-body">
      <p>{c(p.access)}</p>
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{c(['Your data and backups', '数据与备份'])}</h2>
    </div>
    <div class="section-body">
      <p>{c(p.data)}</p>
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{c(['Product information', '产品信息'])}</h2>
    </div>
    <div class="section-body resource-links">
      <a href={href('/support')}>
        <strong>{c(['Support', '使用支持'])}</strong>
        <span aria-hidden="true">→</span>
      </a>
      <a href={href('/privacy')}>
        <strong>{c(['Privacy policy', '隐私政策'])}</strong>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
