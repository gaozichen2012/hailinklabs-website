---
import Layout from '../../layouts/Layout.astro';
import TemplateCards from '../TemplateCards.astro';
import { templates } from '../../data/resources';
import Product from '../../components/Product.astro';
import { categories, featured, listings } from '../../data/catalog';
import { copy } from '../../data/products';
import { site } from '../../data/site';
import { productGalleries, screenshot } from '../../data/screenshots';

import { translator, localizedPath, type Locale } from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
const downloadableCount = Object.keys(listings).length;
const sameJobPreview = productGalleries.samejob[0];
const gearProofPreview = productGalleries.gearproof[0];
const captionIndex = locale === 'en' ? 0 : 1;
---

<Layout
  locale={locale}
  title={
    locale === 'en'
      ? 'Hailink Labs — Small apps. Real-life value.'
      : 'Hailink Labs — 小而专注的 App，解决日常具体问题'
  }
  description={
    locale === 'en'
      ? 'Find iPhone apps for invoicing, equipment handoffs, field records and workout timing. Browse available apps and free worksheets without signing up.'
      : '浏览 Hailink Labs 在美国 App Store 上架的 iPhone App，用于开票、器材借还、动物记录和训练计时。查看填写示例，免注册下载可打印 PDF 和可编辑 CSV 工作表。'
  }
>
  <section class="hero studio-hero">
    <div class="hero-copy">
      <p class="eyebrow">{t('Hailink Labs · Independent software')}</p>
      <h1>
        {locale === 'en' ? 'Small apps.' : '小而专注的 App。'}
        <br />
        <span class="muted-heading">
          {locale === 'en' ? 'Real-life value.' : '解决具体问题。'}
        </span>
      </h1>
      <div class="hero-bottom">
        <p>
          {locale === 'en' ? (
            <>
              Practical iPhone apps for invoicing, equipment handoffs and field
              records. For training, try the{' '}
              <a href={href('/products/hybridloop')}>
                HybridLoop workout timer
              </a>
              .
            </>
          ) : (
            <>
              用 iPhone App 开票、交接器材和记录现场工作，也可以用
              <a href={href('/products/hybridloop')}>HybridLoop 为训练计时</a>。
            </>
          )}
        </p>
        <a class="button" href={`${href('/products')}#downloadable`}>
          {locale === 'en'
            ? `Browse ${downloadableCount} iPhone apps`
            : `浏览 ${downloadableCount} 款 iPhone App`}{' '}
          <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href={href('/templates')}>
          {locale === 'en' ? 'Get free templates' : '获取免费模板'}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <figure class="hero-showcase">
      <div class="showcase-heading">
        <span>
          {locale === 'en' ? 'Made for the everyday' : '为日常而设计'}
        </span>
      </div>
      <div class="showcase-screens">
        <div class="showcase-screen screen-primary">
          <img
            {...screenshot(`/products/samejob/${sameJobPreview.file}.jpg`)}
            sizes="(max-width: 600px) 45vw, (max-width: 1050px) 35vw, 240px"
            fetchpriority="high"
            alt={`SameJob · ${sameJobPreview.caption[captionIndex]}`}
          />
        </div>
        <div class="showcase-screen screen-secondary">
          <img
            {...screenshot(`/products/gearproof/${gearProofPreview.file}.jpg`)}
            sizes="(max-width: 600px) 40vw, (max-width: 1050px) 30vw, 200px"
            decoding="async"
            alt={`GearProof · ${gearProofPreview.caption[captionIndex]}`}
          />
        </div>
      </div>
      <figcaption>
        <span>SameJob &amp; GearProof</span>
        <span>
          {locale === 'en'
            ? 'Actual app screens · Example records'
            : '真实 App 界面 · 示例记录'}
        </span>
      </figcaption>
    </figure>
  </section>
  <nav
    class="collection-strip"
    aria-label={locale === 'en' ? 'Explore by everyday need' : '按日常需求浏览'}
  >
    {categories
      .filter((category) => category.slugs.some((slug) => listings[slug]))
      .map((category) => (
        <a href={`${href('/products')}#${category.id}`}>
          <span>{copy(category.title, locale)}</span>
          <span class="collection-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
  </nav>
  <section class="products-section" aria-labelledby="free-resources-title">
    <div class="section-label">
      <h2 id="free-resources-title">
        {locale === 'en'
          ? 'Start with a free worksheet'
          : '先用免费工作表完成任务'}
      </h2>
    </div>
    <p>
      {locale === 'en'
        ? 'Choose the record you need. Preview a filled example, print a blank sheet or download an editable file. No account or email required.'
        : '选择需要的记录，查看填写示例、打印空白表或下载可编辑文件。无需账号或邮箱。'}
    </p>
    <TemplateCards locale={locale} items={templates} />
    <a class="text-link catalog-all" href={href('/guides')}>
      {locale === 'en' ? 'Read step-by-step guides' : '阅读分步指南'} →
    </a>
  </section>
  <section class="products-section" aria-labelledby="products-title">
    <div class="section-label">
      <h2 id="products-title">
        {locale === 'en' ? 'Featured apps' : '精选 App'}
      </h2>
    </div>
    <div class="product-grid">
      {featured.map((product) => (
        <Product locale={locale} product={product} compact />
      ))}
    </div>
    <a class="text-link catalog-all" href={href('/products')}>
      {locale === 'en' ? 'Explore all apps' : '浏览全部 App'}{' '}
      <span aria-hidden="true">→</span>
    </a>
  </section>
  <section class="section-row company-section" aria-labelledby="company-title">
    <div class="section-label">
      <h2 id="company-title">{t('The company')}</h2>
    </div>
    <div class="section-body">
      <p class="large-copy">
        {t('Built in Shenzhen.')}
        <br />
        {t('Designed for a')}{' '}
        <span class="keep-together">{t('global audience.')}</span>
      </p>
      <p>
        {t(
          'Hailink Labs is a software company based in Shenzhen, China. We focus on simplicity, reliability, and a practical user experience.',
        )}
      </p>

      <a class="text-link" href={href('/about')}>
        {t('About Hailink Labs')} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="section-row contact-section" aria-labelledby="contact-title">
    <div class="section-label">
      <h2 id="contact-title">{t('Get in touch')}</h2>
    </div>
    <div class="section-body">
      <p class="large-copy">
        {t('A question or an idea?')}
        <br />
        {t('We’d like to hear it.')}
      </p>
      <a class="email-link" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
