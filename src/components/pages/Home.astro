---
import Layout from '../../layouts/Layout.astro';
import Product from '../../components/Product.astro';
import { catalog, categories, featured } from '../../data/catalog';
import { copy } from '../../data/products';
import { site } from '../../data/site';

import { translator, localizedPath, type Locale } from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const href = (path: string) => localizedPath(path, locale);
---

<Layout
  locale={locale}
  title={
    locale === 'en'
      ? 'Hailink Labs — Small apps. Real-life value.'
      : 'Hailink Labs — 小而专注的 App，解决日常具体问题'
  }
  description={
    locale === 'en'
      ? 'Focused apps for work, training and family life. Explore practical tools for invoices, equipment, animal care, workouts and learning.'
      : 'Hailink Labs 打造专注工作、运动与家庭生活的 App，涵盖开票、器材交接、动物护理、训练和学习。'
  }
>
  <section class="hero studio-hero">
    <div class="hero-copy">
      <p class="eyebrow">{t('Hailink Labs · Independent software')}</p>
      <h1>
        {locale === 'en' ? 'Small apps.' : '小而专注的 App。'}
        <br />
        <span class="muted-heading">
          {locale === 'en' ? 'Real-life value.' : '解决具体问题。'}
        </span>
      </h1>
      <div class="hero-bottom">
        <p>
          {locale === 'en'
            ? 'Focused apps for work, training, and family life — built to solve one problem well.'
            : '从工作记录到运动训练与家庭学习，把一件事做好。'}
        </p>
        <a class="button" href={href('/products')}>
          {t('Meet our products')} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <figure class="hero-showcase">
      <div class="showcase-heading">
        <span>
          {locale === 'en' ? 'Made for the everyday' : '为日常而设计'}
        </span>
      </div>
      <div class="showcase-screens">
        <div class="showcase-screen screen-primary">
          <img
            src="/products/samejob/01-repeat-invoices.jpg"
            width="663"
            height="1440"
            fetchpriority="high"
            alt={
              locale === 'en'
                ? 'SameJob: actual App Store screen showing repeat invoices'
                : 'SameJob：展示重复开票的真实 App Store 界面'
            }
          />
        </div>
        <div class="showcase-screen screen-secondary">
          <img
            src="/products/gearproof/04-gearproof.jpg"
            width="663"
            height="1440"
            decoding="async"
            alt={
              locale === 'en'
                ? 'GearProof: actual App Store equipment screen'
                : 'GearProof：真实 App Store 器材界面'
            }
          />
        </div>
      </div>
      <figcaption>
        <span>SameJob &amp; GearProof</span>
        <span>
          {locale === 'en'
            ? 'Actual app screens · Example records'
            : '真实 App 界面 · 示例记录'}
        </span>
      </figcaption>
    </figure>
  </section>
  <nav
    class="collection-strip"
    aria-label={locale === 'en' ? 'Explore by everyday need' : '按日常需求浏览'}
  >
    {categories.map((category) => (
      <a href={`${href('/products')}#${category.id}`}>
        <span>{copy(category.title, locale)}</span>
        <span class="collection-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    ))}
  </nav>
  <section class="products-section" aria-labelledby="products-title">
    <div class="section-label">
      <h2 id="products-title">
        {locale === 'en' ? 'Featured apps' : '精选 App'}
      </h2>
      <span class="catalog-count">
        {locale === 'en'
          ? `${catalog.length} apps in the full collection`
          : `完整目录共 ${catalog.length} 款 App`}
      </span>
    </div>
    <div class="product-grid">
      {featured.map((product) => (
        <Product locale={locale} product={product} compact />
      ))}
    </div>
    <a class="text-link catalog-all" href={href('/products')}>
      {locale === 'en' ? 'Explore all apps' : '浏览全部 App'}{' '}
      <span aria-hidden="true">→</span>
    </a>
  </section>
  <section class="section-row company-section" aria-labelledby="company-title">
    <div class="section-label">
      <h2 id="company-title">{t('The company')}</h2>
    </div>
    <div class="section-body">
      <p class="large-copy">
        {t('Built in Shenzhen.')}
        <br />
        {t('Designed for a')}{' '}
        <span class="keep-together">{t('global audience.')}</span>
      </p>
      <p>
        {t(
          'Hailink Labs is a software company based in Shenzhen, China. We focus on simplicity, reliability, and a practical user experience.',
        )}
      </p>

      <a class="text-link" href={href('/about')}>
        {t('About Hailink Labs')} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
  <section class="section-row contact-section" aria-labelledby="contact-title">
    <div class="section-label">
      <h2 id="contact-title">{t('Get in touch')}</h2>
    </div>
    <div class="section-body">
      <p class="large-copy">
        {t('A question or an idea?')}
        <br />
        {t('We’d like to hear it.')}
      </p>
      <a class="email-link" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
