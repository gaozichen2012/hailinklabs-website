---
import Layout from '../../layouts/Layout.astro';
import { familyProducts } from '../../data/family-products';
import { availability } from '../../data/catalog';
import { localizedPath, type Locale } from '../../data/i18n';
import { copy, type Copy } from '../../data/products';
interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const p = familyProducts.find((product) => product.slug === slug)!;
const c = (value: Copy) => copy(value, locale);
const href = (suffix: string) =>
  localizedPath(`/products/${slug}${suffix}`, locale);
---

<Layout
  locale={locale}
  title={`${p.storeName} — ${c(p.subtitle)} | Hailink Labs`}
  description={c(p.description)}
>
  <section class="page-intro product-intro">
    <a class="breadcrumb" href={localizedPath('/products', locale)}>
      {c(['Products', '产品'])} <span aria-hidden="true">/</span>
    </a>
    <p class="eyebrow">{c(p.device)}</p>
    <h1 class="matrix-title" lang="en">
      {p.storeName}
    </h1>
    <p class="intro-copy">{c(p.subtitle)}</p>
    <p class="product-positioning">{c(p.description)}</p>
    <p class="availability">{c(availability(slug))}</p>
    <a class="text-link" href="#pricing">
      {c(['Pricing details', '详细收费规则'])} <span aria-hidden="true">↓</span>
    </a>
  </section>
  <section class="product-story">
    <h2>{c(p.value)}</h2>
    <ul class="prose">
      {p.features.map((feature) => (
        <li>{c(feature)}</li>
      ))}
    </ul>
  </section>
  <section class="section-row" id="pricing">
    <div class="section-label">
      <h2>{c(['Pricing', '价格'])}</h2>
    </div>
    <div class="section-body prose">
      <p>{c(p.pricing)}</p>
      <p class="quiet">
        {c([
          'Prices shown in USD. Apple displays the applicable local price before purchase when the app becomes available.',
          '以上为美元价格。App 可购买时，Apple 会在购买前显示适用的当地价格。',
        ])}
      </p>
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{c(['Your data', '你的数据'])}</h2>
    </div>
    <div class="section-body">
      <p>{c(p.storage)}</p>
    </div>
  </section>
  <section class="section-row">
    <div class="section-label">
      <h2>{c(['Product information', '产品信息'])}</h2>
    </div>
    <div class="section-body resource-links">
      <a href={href('/support')}>
        <strong>{c(['Support', '使用支持'])}</strong>
        <span aria-hidden="true">→</span>
      </a>
      <a href={href('/privacy')}>
        <strong>{c(['Privacy policy', '隐私政策'])}</strong>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
