---
import Layout from '../../layouts/Layout.astro';
import Product from '../../components/Product.astro';
import { products } from '../../data/products';

import { translator, type Locale } from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
---

<Layout
  locale={locale}
  title={t('Products — Hailink Labs')}
  description={
    locale === 'en'
      ? 'Explore SameJob, TMProof, LitterRound, CalvingPocket, GearProof, HybridLoop and PressRecipe: focused iPhone apps for everyday work and records.'
      : '探索 SameJob、TMProof、LitterRound、CalvingPocket、GearProof、HybridLoop 和 PressRecipe，专注日常工作与记录的 iPhone App。'
  }
>
  <section class="page-intro">
    <p class="eyebrow">{t('Our products')}</p>
    <h1>
      {t('Useful by design.')}
      <br />
      <span class="muted-heading">{t('Simple in use.')}</span>
    </h1>
    <p class="intro-copy">
      {t('Focused apps for the work you do again and again.')}
    </p>
  </section>
  <section
    class="product-list product-grid"
    aria-label={t('Hailink Labs products')}
  >
    {products.map((product) => (
      <Product locale={locale} product={product} headingLevel="h2" />
    ))}
  </section>
</Layout>
