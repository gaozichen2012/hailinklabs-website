---
import Layout from '../../layouts/Layout.astro';
import Product from '../../components/Product.astro';

import { translator, type Locale } from '../../data/i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
---

<Layout
  locale={locale}
  title={t('Products — Hailink Labs')}
  description={t(
    'Explore focused apps from Hailink Labs, including Invoice Maker: SameJob for solo service businesses.',
  )}
>
  <section class="page-intro">
    <p class="eyebrow">{t('Our products')}</p>
    <h1>
      {t('Useful by design.')}
      <br />
      <span class="muted-heading">{t('Simple in use.')}</span>
    </h1>
    <p class="intro-copy">
      {t('Focused apps for the work you do again and again.')}
    </p>
  </section>
  <section class="product-list" aria-label={t('Hailink Labs products')}>
    <Product locale={locale} headingLevel="h2" />
  </section>
</Layout>
