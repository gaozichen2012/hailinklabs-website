---
import Layout from '../../layouts/Layout.astro';
import Product from '../../components/Product.astro';
import { localizedPath, type Locale } from '../../data/i18n';
import { copy } from '../../data/products';
import { catalog, categories, listings } from '../../data/catalog';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const downloadable = catalog.filter((product) => listings[product.slug]);
const productsBySlug = new Map(
  catalog.map((product) => [product.slug, product]),
);
---

<Layout
  locale={locale}
  title={
    locale === 'en'
      ? 'iPhone Apps by Hailink Labs'
      : 'iPhone App 目录 — Hailink Labs'
  }
  description={
    locale === 'en'
      ? 'Browse Hailink Labs apps for business, animal records, music practice, workouts and families. See which apps are available on the US App Store.'
      : '按业务、动物记录、音乐练习、运动训练和儿童与家庭场景浏览 Hailink Labs App，并查看可在美国 App Store 下载的应用。'
  }
>
  <section class="page-intro">
    <h1>{locale === 'en' ? 'iPhone apps' : 'iPhone App 目录'}</h1>
  </section>
  <section
    class="products-section"
    id="downloadable"
    aria-labelledby="downloadable-title"
  >
    <h2 id="downloadable-title">
      {locale === 'en' ? 'Apps you can download' : '可下载的 App'}
    </h2>
    <p>
      {locale === 'en'
        ? `${downloadable.length} apps available on the US App Store.`
        : `${downloadable.length} 款 App 可在美国 App Store 下载。`}
    </p>
    <a class="text-link" href="#product-categories">
      {locale === 'en' ? 'Browse the full collection' : '浏览完整目录'}
    </a>
    <div class="product-grid">
      {downloadable.map((product) => (
        <Product
          locale={locale}
          product={product}
          id={`download-${product.slug}`}
          compact
        />
      ))}
    </div>
  </section>
  <details class="full-catalog" open>
    <summary>
      {locale === 'en'
        ? `All ${catalog.length} products by category`
        : `全部 ${catalog.length} 款产品分类目录`}
    </summary>
    <nav
      id="product-categories"
      class="category-links"
      aria-label={locale === 'en' ? 'Product categories' : '产品分类'}
    >
      {categories.map((category) => (
        <a href={`#${category.id}`}>
          {copy(category.title, locale)}{' '}
          <span class="category-count">
            {locale === 'en'
              ? `${category.slugs.filter((slug) => listings[slug]).length} downloadable / ${category.slugs.length} total`
              : `${category.slugs.filter((slug) => listings[slug]).length} 可下载 / ${category.slugs.length} 总数`}
          </span>
        </a>
      ))}
    </nav>
    {categories.map((category) => (
      <section
        class="catalog-group"
        id={category.id}
        aria-labelledby={`${category.id}-title`}
      >
        <div class="catalog-heading">
          <h2 id={`${category.id}-title`}>{copy(category.title, locale)}</h2>
          <span class="catalog-count">
            {locale === 'en'
              ? `${category.slugs.length} ${category.slugs.length === 1 ? 'app' : 'apps'} · ${category.slugs.filter((slug) => listings[slug]).length} downloadable`
              : `${category.slugs.length} 款 App · ${category.slugs.filter((slug) => listings[slug]).length} 可下载`}
          </span>
        </div>
        <div class="product-grid">
          {category.slugs
            .toSorted(
              (a, b) =>
                Number(Boolean(listings[b])) - Number(Boolean(listings[a])),
            )
            .map((slug) => {
              const product = productsBySlug.get(slug)!;
              return listings[slug] ? (
                <p class="available-reference">
                  <a href={localizedPath(`/products/${slug}`, locale)}>
                    {product.name}
                  </a>
                  {' · '}
                  <a
                    href={`#download-${slug}`}
                    aria-label={
                      locale === 'en'
                        ? `Download options for ${product.name}`
                        : `下载方式：${product.name}`
                    }
                  >
                    {locale === 'en' ? 'Download options' : '下载方式'}
                  </a>
                </p>
              ) : (
                <Product locale={locale} product={product} />
              );
            })}
        </div>
        <a class="text-link category-return" href="#product-categories">
          {locale === 'en' ? 'Back to categories' : '返回产品分类'}{' '}
          <span aria-hidden="true">↑</span>
        </a>
      </section>
    ))}
  </details>
</Layout>

<style>
  #downloadable :global(.matrix-card) {
    scroll-margin-top: 1.75rem;
  }
  .full-catalog > summary {
    padding-block: 0.75rem;
    min-height: 44px;
    cursor: pointer;
  }
</style>
