---
interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="product-feature">
  <div class="product-identity">
    <Heading class="product-name">
      <span>Invoice Maker:</span> SameJob
    </Heading>
    <p class="eyebrow">For iPhone · In development</p>
  </div>
  <div class="product-summary">
    <p>
      Less repeat work.
      <br />
      More time for the job.
    </p>
    <p class="product-detail">
      An iOS app for solo service businesses, focused on making repeat invoices
      simpler.
    </p>
    <a class="text-link" href="/products/samejob">
      Explore SameJob <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
