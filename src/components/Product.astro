---
import galleries from '../data/product-galleries.json';
import AppStoreLink from './AppStoreLink.astro';
import { localizedPath, type Locale } from '../data/i18n';
import { copy } from '../data/products';
import { availability, listings, type CatalogProduct } from '../data/catalog';
import { screenshot } from '../data/screenshots';
interface Props {
  locale: Locale;
  product: CatalogProduct;
  compact?: boolean;
  id?: string;
  headingLevel?: 'h2' | 'h3';
}
const {
  locale,
  product,
  id,
  compact = false,
  headingLevel: Heading = 'h3',
} = Astro.props;
const detailsLabel = locale === 'en' ? 'Learn More' : '了解更多';
const preview =
  product.slug === 'samejob'
    ? '01-repeat-invoices'
    : product.slug === 'gearproof'
      ? '04-gearproof'
      : galleries[product.slug as keyof typeof galleries]?.[0]?.file;
---

<article
  id={id}
  tabindex={id ? -1 : undefined}
  class:list={['matrix-card', { 'has-screen': !!preview }]}
>
  <div class="card-art" aria-hidden="true">
    <span class="card-art-name">{product.name}</span>
    {preview && (
      <img
        {...screenshot(`/products/${product.slug}/${preview}.jpg`)}
        sizes="124px"
        alt=""
        loading="lazy"
        decoding="async"
      />
    )}
    <span class="card-art-rule"></span>
  </div>
  <p class="card-category">{copy(product.subtitle, locale)}</p>
  <Heading lang="en">{product.name}</Heading>
  <p
    class:list={['availability', { 'is-available': !!listings[product.slug] }]}
  >
    {copy(availability(product.slug), locale)}
  </p>
  {!compact && (
    <p class="eyebrow" lang="en">
      {product.storeName}
    </p>
  )}
  <p class="card-value">
    {copy(compact ? product.summary : product.value, locale)}
  </p>
  {!compact && (
    <p class="card-description">{copy(product.description, locale)}</p>
  )}
  <a
    class="text-link"
    href={localizedPath(`/products/${product.slug}`, locale)}
    aria-label={`${detailsLabel}: ${product.name}`}
  >
    {detailsLabel} <span aria-hidden="true">→</span>
  </a>
  <AppStoreLink locale={locale} slug={product.slug} source="catalog" />
</article>
