---
import AppStoreLink from './AppStoreLink.astro';
import { localizedPath, type Locale } from '../data/i18n';
import { copy } from '../data/products';
import { availability, listings, type CatalogProduct } from '../data/catalog';
interface Props {
  locale: Locale;
  product: CatalogProduct;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const {
  locale,
  product,
  compact = false,
  headingLevel: Heading = 'h3',
} = Astro.props;
---

<article class="matrix-card">
  <p class="card-category">{copy(product.subtitle, locale)}</p>
  <Heading lang="en">{product.name}</Heading>
  <p
    class:list={['availability', { 'is-available': !!listings[product.slug] }]}
  >
    {copy(availability(product.slug), locale)}
  </p>
  {!compact && (
    <p class="eyebrow" lang="en">
      {product.storeName}
    </p>
  )}
  <p class="card-value">
    {copy(compact ? product.summary : product.value, locale)}
  </p>
  {!compact && (
    <p class="card-description">{copy(product.description, locale)}</p>
  )}
  <a
    class="text-link"
    href={localizedPath(`/products/${product.slug}`, locale)}
    aria-label={`${locale === 'en' ? 'Learn more about' : '了解'} ${product.name}`}
  >
    {locale === 'en' ? 'Learn More' : '了解更多'}{' '}
    <span aria-hidden="true">→</span>
  </a>
  <AppStoreLink locale={locale} slug={product.slug} />
</article>
