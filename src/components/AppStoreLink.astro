---
import { listings, highlights } from '../data/catalog';
import { copy } from '../data/products';
import type { Locale } from '../data/i18n';
interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const listing = listings[slug];
---

{listing && (
  <div class="store-download">
    <a class="text-link" href={listing.url}>
      {locale === 'en'
        ? 'Download on the US App Store'
        : '前往美国 App Store 下载'}
      <span aria-hidden="true">↗</span>
    </a>
    <p class="price-summary">
      {highlights[slug] && copy(highlights[slug].price, locale)}
    </p>
    <p>
      {locale === 'en'
        ? `Free download · iOS ${listing.ios} or later. Link opens the US store. Availability and local prices depend on your Apple account region.`
        : `免费下载 · 需要 iOS ${listing.ios} 或更新版本。链接前往美国商店。实际供应范围和当地价格以 Apple 账号地区为准。`}
    </p>
  </div>
)}

<style>
  .store-download {
    margin-top: 1rem;
  }
  .store-download p {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>
