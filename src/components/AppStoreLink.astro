---
import type { Locale } from '../data/i18n';
interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const listings: Record<string, { url: string; ios: number }> = {
  samejob: {
    url: 'https://apps.apple.com/us/app/invoice-maker-samejob/id6814700434',
    ios: 17,
  },
  gearproof: {
    url: 'https://apps.apple.com/us/app/gearproof-equipment-checkout/id6814847023',
    ios: 18,
  },
};
const listing = listings[slug];
---

{listing && (
  <div class="store-download">
    <a class="text-link" href={listing.url}>
      {locale === 'en'
        ? 'Download on the US App Store'
        : '前往美国 App Store 下载'}
      <span aria-hidden="true">↗</span>
    </a>
    <p>
      {locale === 'en'
        ? `Free download · iOS ${listing.ios} or later. Currently available only in the US App Store.`
        : `免费下载 · 需要 iOS ${listing.ios} 或更新版本。目前仅在美国区供应，中国区 Apple 账号无法下载。`}
    </p>
  </div>
)}

<style>
  .store-download {
    margin-top: 1rem;
  }
  .store-download p {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>
