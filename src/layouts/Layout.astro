---
import '../styles/global.css';
import '../styles/studio.css';
import '../styles/resources.css';
import { canonicalPath, isAlias } from '../data/route-policy';
import { resourceForPath } from '../data/resources';
import { listings } from '../data/catalog';
import { smartAppBanner } from '../data/app-store';
import searchConfig from '../data/search-config.json';
import BrandLogo from '../components/BrandLogo.astro';
import { englishRoutes, site } from '../data/site';
import {
  socialImage,
  structuredData,
  serializeStructuredData,
  searchTitle,
  searchDescription,
} from '../data/seo';
import {
  translator,
  localizedPath,
  companyName,
  type Locale,
} from '../data/i18n';
interface Props {
  locale?: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}
const {
  locale = 'en',
  title: requestedTitle,
  description: requestedDescription,
  noindex: requestedNoindex = false,
} = Astro.props;
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '')
    .replace(/\/$/, '') || '/';
const t = translator(locale);
const englishPath =
  locale === 'zh-CN' ? path.replace(/^\/zh/, '') || '/' : path;
const hasAlternate = englishRoutes.some((route) => route === englishPath);
const otherLocale = locale === 'en' ? 'zh-CN' : 'en';
const alternate = localizedPath(canonicalPath(englishPath), otherLocale);
const noindex = requestedNoindex || isAlias(path);
const canonical = new URL(canonicalPath(path), site.url).href;
const title = searchTitle(path, requestedTitle);
const description = searchDescription(path, requestedDescription);
const resource = resourceForPath(englishPath);
const appSlug =
  resource?.app ||
  Object.keys(listings).find((slug) => englishPath === `/products/${slug}`);
const banner =
  appSlug &&
  smartAppBanner(
    appSlug,
    englishPath.startsWith('/guides/')
      ? 'guide'
      : englishPath.startsWith('/templates/')
        ? 'template'
        : 'product',
    resource?.slug || '',
  );
const googleVerification =
  import.meta.env.GOOGLE_SITE_VERIFICATION || searchConfig.googleVerification;
const bingVerification =
  import.meta.env.BING_SITE_VERIFICATION || searchConfig.bingVerification;
if (googleVerification && !/^[A-Za-z0-9_-]{20,}$/.test(googleVerification))
  throw new Error('Invalid Search Console verification');
if (bingVerification && !/^[a-f0-9]{32}$/i.test(bingVerification))
  throw new Error('Invalid Bing verification');
const preview = socialImage(englishPath, locale);
const schema = noindex
  ? undefined
  : structuredData(englishPath, canonical, locale);
const nav = [
  { href: localizedPath('/products', locale), label: t('Products') },
  {
    href: localizedPath('/guides', locale),
    label: locale === 'en' ? 'Guides' : '指南',
  },
  {
    href: localizedPath('/support', locale),
    label: locale === 'en' ? 'Support' : '支持',
  },
  {
    href: localizedPath('/about', locale),
    label: locale === 'en' ? 'About' : '关于',
  },
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {banner && <meta name="apple-itunes-app" content={banner} />}
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {bingVerification && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hasAlternate && !noindex && (
      <>
        <link
          rel="alternate"
          hreflang="en"
          href={new URL(englishPath, site.url).href}
        />
        <link
          rel="alternate"
          hreflang="zh-CN"
          href={new URL(localizedPath(englishPath, 'zh-CN'), site.url).href}
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(englishPath, site.url).href}
        />
      </>
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta
      property="og:type"
      content={
        englishPath.startsWith('/guides/') && resource ? 'article' : 'website'
      }
    />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={preview.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(preview.width)} />
    <meta property="og:image:height" content={String(preview.height)} />
    <meta property="og:image:alt" content={preview.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview.url} />
    <meta name="twitter:image:alt" content={preview.alt} />
    {schema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeStructuredData(schema)}
      ></script>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1.1" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png?v=1.1"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=1.1"
    />
  </head>
  <body data-page={englishPath}>
    <a class="skip-link" href="#main">
      {t('Skip to content')}
    </a>
    <header class="site-header shell">
      <a
        class="wordmark"
        href={localizedPath('/', locale)}
        aria-label={t('Hailink Labs home')}
      >
        <BrandLogo />
      </a>
      <nav aria-label={t('Main navigation')}>
        {nav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={
              path === href
                ? 'page'
                : path.startsWith(`${href}/`)
                  ? 'location'
                  : undefined
            }
          >
            {label}
          </a>
        ))}
        {hasAlternate && (
          <a
            class="language-switch"
            href={alternate}
            lang={otherLocale}
            hreflang={otherLocale}
            aria-label={
              locale === 'en' ? '切换到本页中文版' : 'Read this page in English'
            }
          >
            {locale === 'en' ? '中文' : 'English'}
          </a>
        )}
      </nav>
    </header>
    <main id="main" class="shell" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div class="footer-top">
        <div>
          <a class="footer-brand" href={localizedPath('/', locale)}>
            <BrandLogo />
          </a>
          <p>{companyName(locale)}</p>
        </div>
        <nav aria-label={t('Footer navigation')}>
          {nav.map(({ href, label }) => (
            <a href={href}>{label}</a>
          ))}
          <a href={localizedPath('/templates', locale)}>
            {locale === 'en' ? 'Free Templates' : '免费模板'}
          </a>
          <a href={localizedPath('/contact', locale)}>{t('Contact')}</a>
        </nav>
      </div>
      <div class="footer-bottom">
        <span>{t('© 2026 Hailink Labs. All rights reserved.')}</span>
        <span>{t('Shenzhen, China')}</span>
      </div>
    </footer>
  </body>
</html>
